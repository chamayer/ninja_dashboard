# ── Retired Metabase recovery archive (local-only) ───────────────────
# Dashboard definitions and Metabase application data can contain production
# configuration. Keep the restoration instructions, but never commit the
# archive artifacts themselves.
/archive/metabase/*
!/archive/metabase/RESTORE.md

# ── PLAN-022 legacy data archive (local-only) ───────────────────────
# Off-host copy of the pg_dump archives taken before the legacy drops.
# Contains customer data: never commit it.
/archive/plan022-legacy-2026-10-26/

# ── Reference data (not code) ────────────────────────────────────────
# NinjaRMM OpenAPI specifications — local development reference used to design
# source connectors and schemas. Re-download from Ninja docs when needed.
docs/reference/ninja-api/NinjaRMM-API-v2*.json

