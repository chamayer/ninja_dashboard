{
  "schema_version": 1,
  "version": "conditions-shadow-1",
  "offline_days": 180,
  "freshness_hours": 48,
  "identity_member_field": "candidate_device_ids",
  "identity_group_type": "identity_conflict",
  "consumers": [
    "issues",
    "admin_health",
    "entity_pages",
    "counts_and_health_history",
    "software_exposure",
    "notifications",
    "digest",
    "source_actions",
    "merge_and_mapping",
    "legacy_and_external"
  ],
  "issue_taxonomy": [
    {"key": "inventory", "label": "Inventory", "types": [
      {"key": "inventory_gaps", "label": "Inventory gaps", "conditions": ["device_source_record_withdrawn", "device_missing_from_source"]},
      {"key": "duplicate_computers", "label": "Duplicate Computers", "conditions": ["identity_conflict", "shared_serial", "cross_client_serial", "cross_client_conflict"]},
      {"key": "duplicate_platform_entries", "label": "Duplicate platform entries", "conditions": ["duplicate_platform_record", "duplicate_device_records"]},
      {"key": "inventory_data_problems", "label": "Inventory data problems", "conditions": ["placeholder_serial", "placeholder_mac", "device_role_conflict", "lifecycle_reported_state_conflict", "lifecycle_unknown_reported_state", "unmapped_node_class"]},
      {"key": "client_matching", "label": "Client matching", "conditions": ["client_name_conflict", "client_link_collision", "client_unattached_group", "unnamed_source_group", "unmatched_source_group", "identity_resolution_pending", "unlinked_external_identity"]},
      {"key": "hudu_maintenance", "label": "Hudu maintenance", "conditions": ["cmdb_asset_stale", "cmdb_link_incorrect", "unintegrated_source_observed"]}
    ]},
    {"key": "agents_reporting", "label": "Agents & reporting", "types": [
      {"key": "required_agents", "label": "Required agents", "conditions": ["missing_required_platform", "device_unenrolled"]},
      {"key": "agents_not_reporting", "label": "Agents not reporting", "conditions": ["stale_required_platform"]},
      {"key": "computers_not_reporting", "label": "Computers not reporting", "conditions": ["device_offline", "device_stale_data", "device_long_offline"]}
    ]},
    {"key": "software_security", "label": "Software & security", "types": [
      {"key": "unapproved_software", "label": "Unapproved software", "conditions": ["unauthorized_remote_access", "unauthorized_rmm", "unauthorized_av"]},
      {"key": "software_classification", "label": "Software classification", "conditions": ["capability_review_candidate"]},
      {"key": "software_approval", "label": "Software approval", "conditions": ["whitelist_suggestion"]},
      {"key": "suspicious_software", "label": "Suspicious software", "conditions": ["rare_recent", "suspicious_name", "install_path_suspicious", "known_malicious_hint"]},
      {"key": "vulnerable_software", "label": "Vulnerable software", "conditions": ["vulnerable_software"]},
      {"key": "unsupported_software", "label": "Unsupported software", "conditions": ["eol_runtime"]},
      {"key": "protection_conflicts", "label": "Protection conflicts", "conditions": ["multi_av_conflict"]}
    ]},
    {"key": "patching_support", "label": "Patching & support", "types": [
      {"key": "patching_not_progressing", "label": "Patching not progressing", "conditions": ["device_never_patched", "patching_stalled", "patch_approval_backlog"]},
      {"key": "patch_failures", "label": "Patch failures", "conditions": ["patch_failing_repeatedly"]},
      {"key": "restarts_required", "label": "Restarts required", "conditions": ["reboot_pending"]},
      {"key": "windows_support", "label": "Windows support", "conditions": ["windows_servicing_approaching_eol", "windows_servicing_eol", "windows_servicing_unknown"]}
    ]},
    {"key": "data_collection", "label": "Data collection", "types": [
      {"key": "collection_failures", "label": "Collection failures", "conditions": ["source_failure"]},
      {"key": "processing_delays", "label": "Processing delays", "conditions": ["software_queue_stalled"]},
      {"key": "collector_reporting", "label": "Collector reporting", "conditions": ["stale_collector_binding"]}
    ]}
  ],
  "issue_type_aliases": [
    {"key": "possible_duplicate_records", "label": "Possible duplicate records", "types": ["identity_conflict", "duplicate_device_records", "duplicate_platform_record"]}
  ],
  "rules": {
    "identity": {
      "effect": "gate",
      "participant_kind": "device",
      "requires": [],
      "explanation": "Unsettled computer identity blocks downstream computer attribution."
    },
    "offline": {
      "effect": "suppress_attention",
      "participant_kind": "device",
      "requires": [],
      "explanation": "Extended loss of agent contact suppresses routine attention; it does not clear the condition."
    },
    "collection": {
      "effect": "gate",
      "requires": [],
      "explanation": "Absence and cleanup conclusions require current, complete evidence for every required source scope."
    }
  },
