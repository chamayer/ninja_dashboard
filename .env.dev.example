# Copy to .env.dev. These credentials are local-only; never use production
# database credentials here. Keep source API credentials blank until needed.

POSTGRES_PASSWORD=local-ninja-password-change-me
OPERATIONS_DB_USER=operations_app
OPERATIONS_DB_PASSWORD=local-operations-password-change-me
OPERATIONS_MIGRATE_DB_USER=operations_migrate
OPERATIONS_MIGRATE_DB_PASSWORD=local-migrate-password-change-me
OPERATIONS_SECRET_KEY=local-only-development-key-change-me
OPERATIONS_ALLOWED_HOSTS=localhost,127.0.0.1
OPERATIONS_INITIAL_ADMIN_PASSWORD=local-admin-password-change-me

# Required settings fields. Enter a separate development API credential only
# when you are ready to collect from Ninja. Other sources use their own
# secret-reference variables below and are configured in Operations.
NINJA_BASE_URL=https://your-instance.rmmservice.com/v2
NINJA_TOKEN_URL=https://your-instance.rmmservice.com/ws/oauth/token
NINJA_CLIENT_ID=
NINJA_CLIENT_SECRET=
NINJA_SCOPE=monitoring

INGEST_SCHEDULE_HOURS=1
NOTIFY_ENABLED=false
NOTIFY_DIGEST_ENABLED=false

# Optional credentials referenced by locally configured source instances.
S1_MAIN_API_TOKEN=
LMI_MAIN_COMPANY_ID=
LMI_MAIN_PSK=
RUON_USERNAME=
RUON_PASSWORD=
HUDU_MAIN_API_TOKEN=
SC_UTA_EXT_GUID=
SC_UTA_SECRET_KEY=
